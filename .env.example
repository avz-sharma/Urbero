# Urbero Environment Configuration (.env.example)
# Copy to .env for local development

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional primary ground-station provider; absent token uses labelled CAMS model data
WAQI_API_TOKEN=

# Gemini structured briefings and travel mode suggestions (optional).
GEMINI_API_KEY=
GEMINI_MODEL=

# Grok (xAI) API Configuration (Server-side only)
# Used strictly for narrative generation & briefings; core math is 100% deterministic
GROK_API_KEY=
# Set an available model ID from your xAI account when enabling Grok.
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1

# Supabase Shared Cache (L2 Cache - Optional, falls back to in-process L1 TTL cache)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rate Limiting (SlowAPI)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_PLANNER=20/minute

